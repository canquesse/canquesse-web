{
  // Cloudflare Workers: only static assets, no worker script on purpose.
  "name": "canquesse-web",
  "compatibility_date": "2026-08-02",
  "assets": {
    // `npm run build` (astro build) writes here
    "directory": "./dist",
    // unknown paths get 404.html with a real 404 status
    "not_found_handling": "404-page"
  }
}
