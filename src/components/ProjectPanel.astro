---
import type { GateCopy, ProjectCopy } from '../content/site';
import type { ProjectBase } from '../content/shared';
import Cover from './Cover.astro';
import Gate from './Gate.astro';
interface Props { project: ProjectCopy & ProjectBase; index: number; total: number; gate: GateCopy }
const { project, index, total, gate } = Astro.props;
const num = String(index + 1).padStart(2, '0');
const count = String(total).padStart(2, '0');
const name = project.name.join(' ');
const live = project.cover === 'gate';
// a card with controls of its own cannot be one big link
const Tag = project.href && !live ? 'a' : 'div';
const open = { href: project.href ?? undefined, target: '_blank', rel: 'noopener' };
---

<article class="project" data-project={index} style={`--i:${index}`}>
  <div class:list={['project-card', `project-card--${project.cover}`]} data-project-card>
    {live && <><canvas class="gate-canvas" data-gate-canvas aria-hidden="true"></canvas><div class="gate-tags micro" data-gate-tags aria-hidden="true"></div></>}
    <Tag class="project-link" {...(Tag === 'a' ? { ...open, 'aria-label': `${name}: ${project.open}` } : {})}>
      <div class="project-top micro"><span>{num} / {count}</span><span>{project.kind}</span></div>
      <div class="cover" data-cover-inner aria-hidden={project.image || live ? undefined : 'true'}>
        {project.image
          ? <img src={project.image} alt={name} loading="lazy" decoding="async" width="1600" height="1000" />
          : live ? <Gate copy={gate} /> : <Cover kind={project.cover} />}
      </div>
      <div class="project-body">
        <h3 class:list={['project-title', project.name.length > 1 && 'project-title--two']} aria-label={name}>{project.name.map((l) => <span aria-hidden="true">{l}</span>)}</h3>
        <div class="project-text">
          <p class="project-desc">{project.description}</p>
          <dl class="project-facts">
            {project.facts.map((f) => <div><dt class="micro">{f.k}</dt><dd>{f.v}</dd></div>)}
          </dl>
          <ul class="chips" role="list">{project.stack.map((item) => <li class="chip">{item}</li>)}</ul>
          {project.href && (live
            ? <a class="link project-open" {...open}>{project.open}<i aria-hidden="true">↗</i></a>
            : <span class="link project-open">{project.open}<i aria-hidden="true">↗</i></span>)}
        </div>
      </div>
    </Tag>
  </div>
</article>
