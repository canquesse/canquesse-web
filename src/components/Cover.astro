---
/** flat drawings that show what each project does, until there are real screenshots.
    They run across the whole card; on narrow screens the right part (the point of it) stays visible. */
import type { ProjectBase } from '../content/shared';
interface Props { kind: ProjectBase['cover'] }
const { kind } = Astro.props;

// film frames: 1 = a scene with the chosen person
const frames = [0, 0, 0, 1, 1, 0, 0, 0, 1, 0, 0, 1, 1, 0];
const W = 112;
// runs of cut frames → arcs over them
const cuts: Array<[number, number]> = [];
frames.forEach((f, i) => { if (f && !frames[i - 1]) cuts.push([i, i + 1]); else if (f) cuts[cuts.length - 1][1] = i + 1; });
// a fortnight of bookable slots
const cells = Array.from({ length: 64 }, (_, i) => (((i * 37 + 11) % 7) < 2 ? 2 : ((i * 53 + 5) % 5) < 1 ? 1 : 0));
// text and vectors
const lines = [.92, .74, .86, .4, .95, .68, .55];
const dots = Array.from({ length: 98 }, (_, i) => Math.round((Math.abs(Math.sin(i * 12.9898) * 43758.5453) % 1) * 3));
const boxes = [[758, 246, 334, 188], [1140, 208, 204, 254], [1392, 156, 156, 308], [780, 26, 214, 210], [62, 256, 470, 178]];
---

{kind === 'room' && (
  <svg class="art art-room" viewBox="0 18 1600 440" preserveAspectRatio="xMaxYMid slice">
    <rect class="wall" width="1600" height="480" />
    <rect class="floor" y="392" width="1600" height="88" />
    <g class="frame-pic"><rect x="180" y="52" width="250" height="150" rx="10" /><path d="M192 190 L262 104 L318 160 L352 130 L418 190 Z" /></g>
    <g class="bed"><rect x="80" y="308" width="430" height="92" rx="22" /><rect x="80" y="266" width="130" height="70" rx="20" /></g>
    <g class="plant"><path d="M618 404 l14 -86 h56 l14 86 Z" /><circle cx="660" cy="250" r="66" /><circle cx="622" cy="290" r="38" /><circle cx="704" cy="286" r="42" /></g>
    <rect class="window" x="792" y="38" width="190" height="186" rx="12" />
    <path class="pane" d="M887 38 V224 M792 131 H982" />
    <g class="sofa"><rect x="770" y="310" width="310" height="112" rx="26" /><rect x="798" y="258" width="254" height="92" rx="24" /></g>
    <g class="table"><rect x="1152" y="356" width="180" height="20" rx="10" /><rect x="1174" y="372" width="14" height="78" rx="7" /><rect x="1296" y="372" width="14" height="78" rx="7" /></g>
    <g class="shelf"><rect x="1404" y="168" width="132" height="284" rx="14" /><rect x="1420" y="186" width="100" height="72" rx="8" /><rect x="1420" y="274" width="100" height="72" rx="8" /></g>
    <g class="lampe"><path d="M1220 222 h44 l18 64 h-80 Z" /><rect x="1237" y="282" width="10" height="76" rx="5" /></g>
    {boxes.map(([x, y, w, h], i) => <rect class="box" x={x} y={y} width={w} height={h} rx="10" pathLength="1" style={`--d:${i * .45}s`} />)}
    <circle class="ball" r="17" />
  </svg>
)}
{kind === 'skip' && (
  <svg class="art art-skip" viewBox="-12 0 1592 372" preserveAspectRatio="xMaxYMid slice">
    {frames.map((f, i) => (
      <g class={f ? 'cut' : 'keep'} transform={`translate(${i * W} 92)`}>
        <rect width="102" height="178" rx="14" />
        <circle cx="51" cy="74" r="23" /><path d="M11 178 a40 46 0 0 1 80 0 Z" />
      </g>
    ))}
    {cuts.map(([a, b]) => <path class="arc" d={`M${a * W - 18} 76 C ${a * W + 10} ${b - a > 1 ? -4 : 18}, ${b * W - 20} ${b - a > 1 ? -4 : 18}, ${b * W + 8} 76`} />)}
    <rect class="bar" x="0" y="322" width="1558" height="14" rx="7" />
    {cuts.map(([a, b]) => <rect class="gap" x={a * W} y="322" width={(b - a) * W} height="14" />)}
    <circle class="head" cx="0" cy="329" r="22" />
  </svg>
)}
{kind === 'grid' && <div class="art art-grid">{cells.map((c, i) => <i class={`c${c}`} style={`--n:${i}`}></i>)}</div>}
{kind === 'lab' && (
  <svg class="art art-lab" viewBox="0 0 1600 420" preserveAspectRatio="xMidYMid slice">
    <rect class="box-a" x="0" y="0" width="760" height="420" rx="30" />
    <rect class="box-b" x="840" y="0" width="760" height="420" rx="30" />
    {lines.map((w, i) => <rect class="line" x="56" y={44 + i * 49} width={648 * w} height="24" rx="12" style={`--n:${i}`} />)}
    {dots.map((c, i) => <circle class={`dot d${c}`} cx={902 + (i % 14) * 49} cy={58 + Math.floor(i / 14) * 51} r="15" style={`--n:${(i * 7) % 23}`} />)}
    <path class="wire" d="M760 210 H840" />
  </svg>
)}
